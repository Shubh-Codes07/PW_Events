# Server port
PORT=3001

# Allowed CORS origin(s) — comma-separated in production (e.g., http://localhost:5173,https://utsav-planner.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key — SECRET, server-only
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# Google Gemini API key — SECRET, server-only
GEMINI_API_KEY=AI...your-gemini-key

# Google Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
